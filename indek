        function autoSaveInvoice() {
            const currentNo = document.getElementById('inv-no').value;
            const subtotal = activeInvoiceItems.reduce((acc, item) => acc + (item.qty * item.harga), 0);
            const totalTerbayar = activeInvoiceRiwayat.reduce((acc, item) => acc + item.nominal, 0);

            const invData = {
                no: currentNo,
                tgl: document.getElementById('inv-tgl').value,
                klien: document.getElementById('inv-klien-nama').value,
                alamat: document.getElementById('inv-klien-alamat').value,
                attn: document.getElementById('inv-klien-attn').value,
                termin: document.getElementById('inv-syarat-termin').value,
                garansi: document.getElementById('inv-syarat-garansi').value,
                bankNama: document.getElementById('inv-bank-nama').value,
                bankNoRek: document.getElementById('inv-bank-norek').value,
                bankAn: document.getElementById('inv-bank-an').value,
                penandatangan: document.getElementById('inv-penandatangan').value,
                status: document.getElementById('inv-status-select').value,
                totalTagihan: subtotal,
                terbayar: totalTerbayar,
                sisaPiutang: subtotal - totalTerbayar,
                items: activeInvoiceItems,
                riwayat: activeInvoiceRiwayat
            };

            const existingIdx = listInvoice.findIndex(i => i.no === currentNo);
