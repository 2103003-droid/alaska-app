        function updateItemVal(idx, key, val) {
            if (key === 'qty') {
                activeInvoiceItems[idx][key] = parseFloat(val) || 0;
            } else if (key === 'harga') {
                const numVal = parseFloat(String(val).replace(/[^0-9]/g, '')) || 0;
                activeInvoiceItems[idx][key] = numVal;
            } else {
                activeInvoiceItems[idx][key] = val;
            }
            
            const item = activeInvoiceItems[idx];
            const total = item.qty * item.harga;
            const cellTotal = document.getElementById(`inv-total-cell-${idx}`);
