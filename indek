            const inv = listInvoice.find(i => i.no === no);
            if (inv) {
                document.getElementById('inv-no').value = inv.no || '';
                document.getElementById('inv-tgl').value = inv.tgl || '';
                document.getElementById('inv-klien-nama').value = inv.klien || '';
                document.getElementById('inv-klien-alamat').value = inv.alamat || '';
                document.getElementById('inv-klien-attn').value = inv.attn || '';
                document.getElementById('inv-syarat-termin').value = inv.termin || '';
                document.getElementById('inv-syarat-garansi').value = inv.garansi || '';
                document.getElementById('inv-bank-nama').value = inv.bankNama || 'Bank Mandiri';
                document.getElementById('inv-bank-norek').value = inv.bankNoRek || '131-00-1234567-8';
                document.getElementById('inv-bank-an').value = inv.bankAn || 'CV ALASKA LOKA SEJAHTERA';
                document.getElementById('inv-penandatangan').value = inv.penandatangan || 'CV ALASKA LOKA SEJAHTERA';
                document.getElementById('inv-status-select').value = inv.status || 'Belum Dibayar (Unpaid)';
                
                activeInvoiceItems = inv.items || [];
                activeInvoiceRiwayat = inv.riwayat || [];

                renderInvoiceItem();
                renderRiwayatCicilan();
                switchTab('buat-inv');
            }
        }

        function hapusInvoice(idx) {
            if (confirm('Hapus invoice ini dari sistem?')) {
                listInvoice.splice(idx, 1);
                localStorage.setItem('ALS_LIST_INVOICE', JSON.stringify(listInvoice));
                renderAnalisisInv();
                updateDashboard();
            }
        }

        function updateDashboard() {
            const totalMasuk = dataKas.filter(k => k.jenis === 'masuk').reduce((a, b) => a + b.nominal, 0);
            const totalKeluar = dataKas.filter(k => k.jenis === 'keluar').reduce((a, b) => a + b.nominal, 0);
            const totalPiutang = listInvoice.reduce((a, b) => a + b.sisaPiutang, 0);

            document.getElementById('dash-uang-masuk').innerText = 'Rp ' + totalMasuk.toLocaleString('id-ID');
            document.getElementById('dash-uang-keluar').innerText = 'Rp ' + totalKeluar.toLocaleString('id-ID');
            document.getElementById('dash-piutang').innerText = 'Rp ' + totalPiutang.toLocaleString('id-ID');
            document.getElementById('dash-net-kas').innerText = 'Rp ' + (totalMasuk - totalKeluar).toLocaleString('id-ID');

            const containerSaldo = document.getElementById('dash-list-akun-saldo');
            containerSaldo.innerHTML = '';

            akunKas.forEach(akun => {
                const masuk = dataKas.filter(k => k.akun === akun && k.jenis === 'masuk').reduce((a, b) => a + b.nominal, 0);
                const keluar = dataKas.filter(k => k.akun === akun && k.jenis === 'keluar').reduce((a, b) => a + b.nominal, 0);
                const saldo = masuk - keluar;

                containerSaldo.innerHTML += `
                    <div class="p-3 bg-slate-50 border rounded-lg">
                        <p class="text-xs font-bold text-slate-500">${akun}</p>
                        <p class="text-base font-black ${saldo >= 0 ? 'text-slate-800' : 'text-rose-600'} mt-1">Rp ${saldo.toLocaleString('id-ID')}</p>
                    </div>`;
            });
        }

        // FITUR EXPORT KAS PER PERIODE & AKUN
        function bukaModalExportKas() {
            document.getElementById('export-kas-akun').value = selectedAkunKas;
            document.getElementById('export-kas-start').value = document.getElementById('filter-kas-start').value;
            document.getElementById('export-kas-end').value = document.getElementById('filter-kas-end').value;
            document.getElementById('modal-export-kas').classList.remove('hidden');
        }

        function tutupModalExportKas() {
            document.getElementById('modal-export-kas').classList.add('hidden');
        }

        function prosesExportKasToExcel() {
            const akunPilihan = document.getElementById('export-kas-akun').value;
            const tglStart = document.getElementById('export-kas-start').value;
            const tglEnd = document.getElementById('export-kas-end').value;

            let filtered = dataKas.filter(item => {
                let matchAkun = true;
                if (akunPilihan !== '') {
                    matchAkun = item.akun === akunPilihan;
                }

                let matchTgl = true;
                if (tglStart) matchTgl = matchTgl && (item.tgl >= tglStart);
                if (tglEnd) matchTgl = matchTgl && (item.tgl <= tglEnd);

                return matchAkun && matchTgl;
            });

            filtered.sort((a, b) => new Date(a.tgl) - new Date(b.tgl));

            if (filtered.length === 0) {
                alert('Tidak ada transaksi kas yang sesuai dengan kriteria/periode tanggal yang dipilih.');
                return;
            }

            const headerAkun = akunPilihan === '' ? 'Semua Akun Kas' : akunPilihan;
            const headerPeriode = (tglStart || tglEnd) ? `${tglStart || 'Awal'} s.d. ${tglEnd || 'Selesai'}` : 'Semua Periode';

            let totalMasuk = 0;
            let totalKeluar = 0;

            const excelData = [
                ["LAPORAN TRANSAKSI KAS - CV ALASKA LOKA SEJAHTERA"],
                ["Akun Kas", headerAkun],
                ["Periode Tanggal", headerPeriode],
                [],
                ["Tanggal Nota", "No. Nota / Ref", "Akun Kas", "Nama Toko / Supplier", "Jenis Mutasi", "Keterangan Detail", "Nominal (Rp)", "Status Bukti Nota"]
            ];

            filtered.forEach(item => {
                if (item.jenis === 'masuk') totalMasuk += item.nominal;
                if (item.jenis === 'keluar') totalKeluar += item.nominal;

                let buktiText = item.fileNota || '-';
                if (item.fileData && item.fileData.startsWith('data:')) {
                    buktiText = `${item.fileNota} (Ada File Nota)`;
                }

                excelData.push([
                    item.tgl,
                    item.nota,
                    item.akun,
                    item.tokoSupplier || '-',
                    item.jenis.toUpperCase(),
                    item.ket,
                    item.nominal,
                    buktiText
                ]);
            });

            excelData.push([]);
            excelData.push(["", "", "", "", "", "TOTAL UANG MASUK", totalMasuk]);
            excelData.push(["", "", "", "", "", "TOTAL UANG KELUAR", totalKeluar]);
            excelData.push(["", "", "", "", "", "SALDO BERSIH (NET)", totalMasuk - totalKeluar]);

            const ws = XLSX.utils.aoa_to_sheet(excelData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Laporan Kas");

            const namaFileAkun = akunPilihan ? akunPilihan.replace(/[^a-zA-Z0-9]/g, '_') : 'Semua_Kas';
            const namaFile = `Laporan_Kas_${namaFileAkun}_${tglStart || 'Awal'}_s.d_${tglEnd || 'Akhir'}.xlsx`;

            XLSX.writeFile(wb, namaFile);
            tutupModalExportKas();
        }

        function exportInvoiceToExcel() {
            const table = document.getElementById('table-invoice');
            const wb = XLSX.utils.table_to_book(table, { sheet: "Analisis Invoice" });
            XLSX.writeFile(wb, "Analisis_Invoice_Piutang_CV_ALS.xlsx");
        }

        function exportDashboardSummary() {
            const summaryData = [
                ["CV ALASKA LOKA SEJAHTERA - RINGKASAN KEUANGAN"],
                ["Tanggal Ekspor", new Date().toLocaleDateString('id-ID')],
                [],
                ["Kategori", "Nominal (Rp)"],
                ["Total Uang Masuk", dataKas.filter(k => k.jenis === 'masuk').reduce((a, b) => a + b.nominal, 0)],
                ["Total Uang Keluar", dataKas.filter(k => k.jenis === 'keluar').reduce((a, b) => a + b.nominal, 0)],
                ["Saldo Kas Bersih", dataKas.filter(k => k.jenis === 'masuk').reduce((a, b) => a + b.nominal, 0) - dataKas.filter(k => k.jenis === 'keluar').reduce((a, b) => a + b.nominal, 0)],
                ["Total Piutang Berjalan", listInvoice.reduce((a, b) => a + b.sisaPiutang, 0)]
            ];
            const ws = XLSX.utils.aoa_to_sheet(summaryData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Ringkasan");
            XLSX.writeFile(wb, "Ringkasan_Keuangan_CV_ALS.xlsx");
        }

        function previewLogo(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('inv-logo-img').src = e.target.result;
                    document.getElementById('inv-logo-img').classList.remove('hidden');
                    document.getElementById('inv-logo-placeholder').classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewTTD(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('inv-ttd-img').src = e.target.result;
                    document.getElementById('inv-ttd-img').classList.remove('hidden');
                    document.getElementById('inv-ttd-placeholder').classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function resizeBox(elementId, widthValue, baseHeight) {
            const el = document.getElementById(elementId);
            el.style.width = widthValue + 'px';
            el.style.height = (widthValue * (baseHeight / 112)) + 'px';
        }
    </script>
