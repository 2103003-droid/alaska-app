        function updateFormFromNotaManual() {
            if (itemNotaManualList.length === 0) return;

            let totalNominal = 0;
            let deskripsiArr = [];

            itemNotaManualList.forEach(item => {
                const qty = parseFloat(item.qty) || 0;
                const hg = parseFloat(item.harga) || 0;
                const subTotal = qty * hg;
                totalNominal += subTotal;

                if (item.desc && item.desc.trim() !== '') {
                    const stn = item.satuan ? ` ${item.satuan}` : '';
                    deskripsiArr.push(`${item.desc.trim()} (${qty}${stn} x Rp ${hg.toLocaleString('id-ID')} = Rp ${subTotal.toLocaleString('id-ID')})`);
                }
            });

            if (totalNominal > 0) {
                document.getElementById('kas-nominal').value = totalNominal;
            }
            if (deskripsiArr.length > 0) {
                document.getElementById('kas-ket').value = deskripsiArr.join('; ');
            }
        }

        function simpanKas() {
            const editIndex = parseInt(document.getElementById('edit-kas-index').value);
            const tgl = document.getElementById('kas-tgl').value;
            const akun = document.getElementById('kas-akun').value;
            const jenis = document.getElementById('kas-jenis').value;
            const tokoSupplier = document.getElementById('kas-toko-supplier').value.trim();
            const nota = document.getElementById('kas-nota-ref').value;
            const nominal = parseFloat(document.getElementById('kas-nominal').value) || 0;
            const ket = document.getElementById('kas-ket').value;
            const fileInput = document.getElementById('kas-file-nota');

            if (tokoSupplier && !listTokoSupplier.includes(tokoSupplier)) {
                listTokoSupplier.push(tokoSupplier);
                renderDatalistToko();
            }

            const processSave = (fileName, fileData) => {
                const transObj = { 
                    tgl, 
                    nota, 
                    akun, 
                    jenis, 
                    tokoSupplier, 
                    nominal, 
                    ket, 
                    fileNota: fileName,
                    fileData: fileData,
                    itemsManual: [...itemNotaManualList] 
                };

                if (editIndex >= 0) {
                    dataKas[editIndex] = transObj;
                    alert('Transaksi Berhasil Diperbarui!');
                } else {
                    dataKas.push(transObj);
                    alert('Transaksi Kas Berhasil Disimpan!');
                }

                localStorage.setItem('ALS_DATA_KAS', JSON.stringify(dataKas));
                batalEditKas();
                renderTabelKas();
                renderAkunKas();
                updateDashboard();
            };

            if (fileInput.files[0]) {
                const file = fileInput.files[0];
                const reader = new FileReader();
                reader.onload = function(e) {
                    processSave(file.name, e.target.result);
                };
                reader.readAsDataURL(file);
            } else if (editIndex >= 0 && dataKas[editIndex]) {
                processSave(dataKas[editIndex].fileNota || '-', dataKas[editIndex].fileData || '');
            } else {
                processSave('-', '');
            }
        }

