<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Keuangan & Invoice - CV Alaska Loka Sejahtera</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        @media print {
            body { background-color: white !important; color: black !important; }
            #login-page, header, aside, .no-print, button, input[type="file"], input[type="range"] { display: none !important; }
            #app, main, #sec-buat-inv { display: block !important; padding: 0 !important; margin: 0 !important; background: transparent !important; }
            #invoice-paper { box-shadow: none !important; border: none !important; max-width: 100% !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
            input, select, textarea { border: none !important; background: transparent !important; appearance: none !important; }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800">

    <div id="login-page" class="min-h-screen flex items-center justify-center bg-slate-900 px-4">
        <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md border-t-4 border-cyan-600">
            <div class="text-center mb-6">
                <i class="fa-solid fa-snowflake text-cyan-600 text-4xl mb-2"></i>
                <h1 class="text-2xl font-black text-slate-800 tracking-wide">CV ALASKA LOKA SEJAHTERA</h1>
                <p class="text-xs text-slate-500 font-semibold mt-1">SISTEM KEUANGAN, KAS & INVOICE</p>
            </div>
            <form id="form-login" onsubmit="event.preventDefault(); login();" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Username</label>
                    <input type="text" id="login-user" value="admin" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-cyan-500 outline-none" required>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Password</label>
                    <input type="password" id="login-pass" value="admin123" class="w-full border rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-cyan-500 outline-none" required>
                </div>
                <button type="submit" class="w-full bg-cyan-700 hover:bg-cyan-800 text-white font-bold py-2.5 rounded-lg shadow transition">Masuk Sistem</button>
            </form>
            <p class="text-xs text-center text-slate-400 mt-4">*Default login: admin / admin123</p>
        </div>
    </div>

    <div id="app" class="hidden min-h-screen flex flex-col">
        <header class="bg-slate-900 text-white px-6 py-3.5 flex justify-between items-center shadow-md border-b-2 border-cyan-500">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-snowflake text-cyan-400 text-2xl"></i>
                <div>
                    <h1 class="font-black tracking-wide text-base leading-tight">CV ALASKA LOKA SEJAHTERA</h1>
                    <p class="text-[11px] text-slate-400">Spesialis Cold Storage Room & Perakitan Pendingin</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-xs bg-slate-800 px-3 py-1.5 rounded-full border border-slate-700 text-cyan-300 font-medium">
                    <i class="fa-solid fa-user-shield text-green-400 mr-1.5"></i> Admin Keuangan
                </span>
                <button onclick="logout()" class="text-xs bg-red-600 hover:bg-red-700 px-3 py-1.5 rounded-lg text-white font-bold transition">
                    <i class="fa-solid fa-right-from-bracket mr-1"></i> Keluar
                </button>
            </div>
        </header>

        <div class="flex flex-1">
            <aside class="w-64 bg-slate-800 text-slate-300 p-4 space-y-2 border-r border-slate-700">
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 mb-2">NAVIGASI UTAMA</div>
                
                <button onclick="switchTab('dashboard')" class="nav-btn w-full text-left p-3 rounded-lg font-semibold text-xs hover:bg-slate-700 transition flex items-center gap-3" id="nav-dashboard">
                    <i class="fa-solid fa-chart-pie w-5 text-cyan-400 text-base"></i> Dashboard Keuangan
                </button>
                <button onclick="switchTab('kas')" class="nav-btn w-full text-left p-3 rounded-lg font-semibold text-xs hover:bg-slate-700 transition flex items-center gap-3" id="nav-kas">
                    <i class="fa-solid fa-money-bill-transfer w-5 text-emerald-400 text-base"></i> Transaksi Masuk/Keluar Uang
                </button>
                <button onclick="switchTab('analisis-inv')" class="nav-btn w-full text-left p-3 rounded-lg font-semibold text-xs hover:bg-slate-700 transition flex items-center gap-3" id="nav-analisis-inv">
                    <i class="fa-solid fa-file-invoice-dollar w-5 text-amber-400 text-base"></i> Analisis Invoice & Piutang
                </button>
                <button onclick="switchTab('buat-inv')" class="nav-btn w-full text-left p-3 rounded-lg font-semibold text-xs hover:bg-slate-700 transition flex items-center gap-3" id="nav-buat-inv">
                    <i class="fa-solid fa-pen-to-square w-5 text-indigo-400 text-base"></i> Buat / Edit Invoice
                </button>
            </aside>

            <main class="flex-1 p-6 bg-slate-100 overflow-y-auto">

                <section id="sec-dashboard" class="space-y-6 tab-content">
                    <div class="flex justify-between items-center border-b pb-3">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Dashboard Statistik Keuangan</h2>
                            <p class="text-xs text-slate-500">Ringkasan arus kas, saldo bank, dan piutang pelanggan real-time.</p>
                        </div>
                        <button onclick="exportDashboardSummary()" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-2">
                            <i class="fa-solid fa-file-excel text-sm"></i> Download Laporan Ringkasan (Excel)
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="bg-white p-5 rounded-xl border-l-4 border-emerald-500 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 uppercase">Total Uang Masuk</p>
                                    <h3 class="text-xl font-black text-emerald-600 mt-1" id="dash-uang-masuk">Rp 0</h3>
                                </div>
                                <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600"><i class="fa-solid fa-arrow-down-left text-xl"></i></div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border-l-4 border-rose-500 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 uppercase">Total Uang Keluar</p>
                                    <h3 class="text-xl font-black text-rose-600 mt-1" id="dash-uang-keluar">Rp 0</h3>
                                </div>
                                <div class="p-2 bg-rose-50 rounded-lg text-rose-600"><i class="fa-solid fa-arrow-up-right text-xl"></i></div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border-l-4 border-amber-500 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 uppercase">Total Piutang Berjalan</p>
                                    <h3 class="text-xl font-black text-amber-600 mt-1" id="dash-piutang">Rp 0</h3>
                                </div>
                                <div class="p-2 bg-amber-50 rounded-lg text-amber-600"><i class="fa-solid fa-hand-holding-dollar text-xl"></i></div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border-l-4 border-cyan-600 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-[11px] font-bold text-slate-400 uppercase">Bersih (Net Cash Balance)</p>
                                    <h3 class="text-xl font-black text-cyan-700 mt-1" id="dash-net-kas">Rp 0</h3>
                                </div>
                                <div class="p-2 bg-cyan-50 rounded-lg text-cyan-600"><i class="fa-solid fa-wallet text-xl"></i></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-xl shadow-sm border space-y-3">
                        <h3 class="font-bold text-sm text-slate-800 border-b pb-2"><i class="fa-solid fa-building-columns text-cyan-700 mr-2"></i>Rincian Saldo Per Akun Kas</h3>
                        <div id="dash-list-akun-saldo" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div>
                    </div>
                </section>

                <section id="sec-kas" class="space-y-6 tab-content hidden">
                    <div class="flex justify-between items-center border-b pb-3">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Pencatatan & Transaksi Uang Masuk / Keluar</h2>
                            <p class="text-xs text-slate-500">Pilih akun kas di sebelah kiri untuk melihat mutasi transaksi masing-masing akun.</p>
                        </div>
                        <button onclick="bukaModalExportKas()" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-2">
                            <i class="fa-solid fa-file-excel text-sm"></i> Export Transaksi Kas (Excel)
                        </button>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                        <div class="bg-slate-950 p-5 rounded-xl shadow-lg border border-slate-800 text-white space-y-4">
                            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400"><i class="fa-solid fa-wallet mr-1"></i> Pilih Akun Kas</h3>
                            </div>

                            <div class="flex gap-1.5 mb-2">
                                <input type="text" id="akun-baru-nama" placeholder="Nama Akun Baru..." class="bg-slate-900 border border-slate-700 text-white px-2 py-1 text-xs rounded outline-none focus:border-cyan-500 w-full">
                                <button onclick="tambahAkunKas()" class="bg-cyan-600 hover:bg-cyan-500 text-white px-3 py-1 text-xs rounded font-bold transition">+</button>
                            </div>

                            <div id="container-akun-kas" class="space-y-1 text-xs font-semibold"></div>
                        </div>

                        <div class="lg:col-span-3 space-y-6">

                            <div class="bg-white p-5 rounded-xl shadow-sm border space-y-4" id="box-form-transaksi">
                                <div class="flex justify-between items-center border-b pb-2">
                                    <h3 class="font-bold text-sm text-slate-800" id="title-form-kas"><i class="fa-solid fa-pen-to-square text-cyan-600 mr-2"></i>Form Transaksi (<span id="label-akun-aktif" class="text-cyan-700">Semua Akun Kas</span>)</h3>
                                    <button type="button" id="btn-batal-edit" onclick="batalEditKas()" class="hidden bg-slate-500 hover:bg-slate-600 text-white text-xs px-3 py-1 rounded font-bold transition"><i class="fa-solid fa-xmark mr-1"></i> Batal Edit</button>
                                </div>
                                <form id="form-trans-kas" onsubmit="event.preventDefault(); simpanKas();" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <input type="hidden" id="edit-kas-index" value="-1">
                                    
                                    <div>
                                        <label class="block text-xs font-bold mb-1">Tanggal Transaksi / Nota</label>
                                        <input type="date" id="kas-tgl" class="w-full border p-2 rounded-lg text-xs" required>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold mb-1">Pilihan Akun Kas</label>
                                        <select id="kas-akun" class="w-full border p-2 rounded-lg text-xs font-bold text-slate-700" required></select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold mb-1">Jenis Mutasi Uang</label>
                                        <select id="kas-jenis" class="w-full border p-2 rounded-lg text-xs font-bold" required>
                                            <option value="masuk" class="text-emerald-600">UANG MASUK (Kas Masuk)</option>
                                            <option value="keluar" class="text-rose-600">UANG KELUAR (Kas Keluar)</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-bold mb-1"><i class="fa-solid fa-store text-cyan-700 mr-1"></i>Nama Toko / Supplier / Pihak Terkait</label>
                                        <input type="text" id="kas-toko-supplier" list="list-toko-supplier" placeholder="Pilih / ketik nama toko..." class="w-full border p-2 rounded-lg text-xs font-bold text-slate-800 focus:ring-2 focus:ring-cyan-500 outline-none" required>
                                        <datalist id="list-toko-supplier"></datalist>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-bold mb-1">No. Nota / Kwitansi / Referensi</label>
                                        <input type="text" id="kas-nota-ref" placeholder="MISAL: NOTA-8821 / KW-002" class="w-full border p-2 rounded-lg text-xs" required>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold mb-1">Nominal Transaksi (Rp)</label>
                                        <input type="number" id="kas-nominal" placeholder="0" class="w-full border p-2 rounded-lg text-xs font-bold bg-slate-50" required>
                                    </div>
                                    <div class="md:col-span-3">
                                        <label class="block text-xs font-bold mb-1">Upload Bukti Nota (Gambar/PDF)</label>
                                        <input type="file" id="kas-file-nota" accept="image/*,.pdf" class="w-full text-xs border p-1.5 rounded-lg bg-slate-50">
                                        <p id="preview-file-nota-nama" class="text-[10px] text-slate-500 mt-0.5 font-semibold"></p>
                                    </div>

                                    <div class="md:col-span-3 bg-slate-50 p-3.5 rounded-lg border space-y-2">
                                        <div class="flex justify-between items-center border-b pb-1.5">
                                            <div>
                                                <label class="text-xs font-bold text-cyan-800"><i class="fa-solid fa-list-check mr-1"></i> Rincian Nota Manual (Opsional)</label>
                                                <p class="text-[10px] text-slate-500">Ketik bebas langsung di kolom bawah ini. Total harga dan keterangan akan terhitung otomatis.</p>
                                            </div>
                                            <button type="button" onclick="tambahItemNotaManual()" class="bg-cyan-700 hover:bg-cyan-800 text-white px-2.5 py-1 rounded text-[11px] font-bold"><i class="fa-solid fa-plus mr-1"></i>Tambah Item Nota</button>
                                        </div>
                                        <div id="container-nota-manual" class="space-y-1.5"></div>
                                    </div>

                                    <div class="md:col-span-3">
                                        <label class="block text-xs font-bold mb-1">Keterangan / Rincian Pengeluaran/Penerimaan</label>
                                        <input type="text" id="kas-ket" placeholder="Ketik keterangan langsung atau gunakan Rincian Nota Manual di atas..." class="w-full border p-2 rounded-lg text-xs font-medium" required>
                                    </div>
                                    <div class="md:col-span-3 flex justify-end gap-2">
                                        <button type="submit" id="btn-submit-kas" class="bg-cyan-700 hover:bg-cyan-800 text-white font-bold px-6 py-2.5 rounded-lg text-xs shadow transition">
                                            <i class="fa-solid fa-floppy-disk mr-1"></i> Simpan Transaksi Uang
                                        </button>
                                    </div>
                                </form>
                            </div>

                            <div class="bg-white p-5 rounded-xl shadow-sm border space-y-4">
                                <div class="flex flex-wrap justify-between items-center gap-2 border-b pb-2">
                                    <h3 class="font-bold text-sm text-slate-800"><i class="fa-solid fa-filter text-cyan-600 mr-2"></i>Daftar Transaksi (<span id="label-tabel-akun" class="text-cyan-700 font-extrabold">Semua Akun Kas</span>)</h3>
                                    
                                    <div class="flex items-center gap-3">
                                        <button onclick="hapusSemuaKas()" class="bg-rose-600 hover:bg-rose-700 text-white text-xs px-3 py-1.5 rounded-lg font-bold shadow transition flex items-center gap-1.5">
                                            <i class="fa-solid fa-trash-can"></i> Hapus Keseluruhan Transaksi
                                        </button>
                                        <div class="flex items-center gap-1.5 border-l pl-3">
                                            <label class="text-xs font-bold text-slate-600">Urutan:</label>
                                            <select id="sort-kas-tgl" onchange="renderTabelKas()" class="border text-xs p-1 rounded font-bold bg-slate-50">
                                                <option value="desc">Tanggal Terbaru → Terlama</option>
                                                <option value="asc">Tanggal Terlama → Terbaru</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 bg-slate-50 p-3 rounded-lg border">
                                    <div>
                                        <label class="block text-[11px] font-bold mb-1">Kata Kunci (Keterangan / Supplier / Ref Nota)</label>
                                        <input type="text" id="filter-kas-text" onkeyup="renderTabelKas()" placeholder="Cari..." class="w-full border p-1.5 rounded text-xs">
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-bold mb-1">Filter Jenis Transaksi</label>
                                        <select id="filter-kas-jenis" onchange="renderTabelKas()" class="w-full border p-1.5 rounded text-xs">
                                            <option value="">Semua Mutasi</option>
                                            <option value="masuk">Uang Masuk saja</option>
                                            <option value="keluar">Uang Keluar saja</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[11px] font-bold mb-1">Dari Tanggal - Sampai Tanggal</label>
                                        <div class="flex gap-1">
                                            <input type="date" id="filter-kas-start" onchange="renderTabelKas()" class="w-1/2 border p-1.5 rounded text-[10px]">
                                            <input type="date" id="filter-kas-end" onchange="renderTabelKas()" class="w-1/2 border p-1.5 rounded text-[10px]">
                                        </div>
                                    </div>
                                </div>

                                <div class="overflow-x-auto">
                                    <table id="table-kas" class="w-full text-xs text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-800 text-white border-b">
                                                <th class="p-2.5">Tanggal Nota</th>
                                                <th class="p-2.5">No. Nota / Ref</th>
                                                <th class="p-2.5">Akun Kas</th>
                                                <th class="p-2.5">Nama Toko / Supplier</th>
                                                <th class="p-2.5">Jenis</th>
                                                <th class="p-2.5">Keterangan Detail</th>
                                                <th class="p-2.5 text-right">Nominal (Rp)</th>
                                                <th class="p-2.5 text-center">Bukti Nota</th>
                                                <th class="p-2.5 text-center">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbody-kas"></tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <section id="sec-analisis-inv" class="space-y-6 tab-content hidden">
                    <div class="flex justify-between items-center border-b pb-3">
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Analisis Invoice & Rekapitulasi Piutang</h2>
                            <p class="text-xs text-slate-500">Monitor invoice yang belum dibayar, sebagian terbayar, dan lunas.</p>
                        </div>
                        <button onclick="exportInvoiceToExcel()" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 rounded-lg text-xs font-bold shadow flex items-center gap-2">
                            <i class="fa-solid fa-file-excel text-sm"></i> Export Analisis Invoice (Excel)
                        </button>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-bold mb-1">Cari Nama Klien / No. Invoice</label>
                            <input type="text" id="filter-inv-q" onkeyup="renderAnalisisInv()" placeholder="Ketik kata kunci..." class="w-full border p-2 rounded-lg text-xs">
                        </div>
                        <div>
                            <label class="block text-xs font-bold mb-1">Filter Status Pembayaran</label>
                            <select id="filter-inv-status" onchange="renderAnalisisInv()" class="w-full border p-2 rounded-lg text-xs">
                                <option value="">Semua Status</option>
                                <option value="Belum Dibayar (Unpaid)">Belum Dibayar (Unpaid)</option>
                                <option value="Dibayar Sebagian (DP)">Dibayar Sebagian (DP)</option>
                                <option value="Lunas (Paid)">Lunas (Paid)</option>
                            </select>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-xl shadow-sm border overflow-x-auto">
                        <table id="table-invoice" class="w-full text-xs text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-800 text-white border-b">
                                    <th class="p-2.5">No. Invoice</th>
                                    <th class="p-2.5">Tanggal</th>
                                    <th class="p-2.5">Klien / Perusahaan</th>
                                    <th class="p-2.5 text-right">Total Tagihan</th>
                                    <th class="p-2.5 text-right">Terbayar</th>
                                    <th class="p-2.5 text-right">Sisa Piutang</th>
                                    <th class="p-2.5 text-center">Status</th>
                                    <th class="p-2.5 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-analisis-inv"></tbody>
                        </table>
                    </div>
                </section>

                <section id="sec-buat-inv" class="space-y-4 tab-content hidden">
                    <div class="no-print flex justify-between items-center bg-white p-3 rounded-xl shadow-sm border">
                        <span class="text-xs font-bold text-emerald-600"><i class="fa-solid fa-circle-check"></i> Auto-Save Penyimpanan Otomatis Aktif</span>
                        <div class="flex gap-2">
                            <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-900 text-white px-4 py-2 rounded-lg text-xs font-bold"><i class="fa-solid fa-print mr-1"></i> Cetak Invoice / Simpan PDF</button>
                            <button onclick="simpanInvoiceKeDatabase()" class="bg-cyan-700 hover:bg-cyan-800 text-white px-4 py-2 rounded-lg text-xs font-bold"><i class="fa-solid fa-floppy-disk mr-1"></i> Simpan Invoice</button>
                        </div>
                    </div>

                    <div id="invoice-paper" class="bg-white p-8 max-w-4xl mx-auto shadow-xl border rounded-sm text-slate-800 space-y-6 text-xs">
                        <div class="flex justify-between items-start border-b-2 border-slate-900 pb-4">
                            <div class="flex gap-4 items-center">
                                <div class="flex flex-col items-center">
                                    <div id="inv-logo-box" class="w-28 h-16 border-2 border-dashed border-slate-300 flex items-center justify-center text-center relative rounded overflow-hidden no-print-border">
                                        <input type="file" id="inv-logo-input" onchange="previewLogo(this)" class="absolute inset-0 opacity-0 cursor-pointer">
                                        <img id="inv-logo-img" class="hidden object-contain max-w-full max-h-full">
                                        <span id="inv-logo-placeholder" class="text-[10px] text-slate-400"><i class="fa-solid fa-upload"></i> Upload Logo</span>
                                    </div>
                                    <div class="no-print mt-1 flex flex-col items-center">
