            const filterJenis = document.getElementById('filter-kas-jenis').value;
            const filterStart = document.getElementById('filter-kas-start').value;
            const filterEnd = document.getElementById('filter-kas-end').value;
            const sortOrder = document.getElementById('sort-kas-tgl').value;

            tbody.innerHTML = '';

            let filteredData = dataKas.filter(item => {
                const matchQ = item.ket.toLowerCase().includes(filterQ) || 
                               item.nota.toLowerCase().includes(filterQ) || 
                               (item.tokoSupplier && item.tokoSupplier.toLowerCase().includes(filterQ));
                const matchAkun = selectedAkunKas === '' || item.akun === selectedAkunKas;
                const matchJenis = filterJenis === '' || item.jenis === filterJenis;
                
                let matchDate = true;
                if (filterStart) matchDate = matchDate && (item.tgl >= filterStart);
                if (filterEnd) matchDate = matchDate && (item.tgl <= filterEnd);

                return matchQ && matchAkun && matchJenis && matchDate;
            });

            filteredData.sort((a, b) => {
                let dateA = new Date(a.tgl);
                let dateB = new Date(b.tgl);
                return sortOrder === 'desc' ? dateB - dateA : dateA - dateB;
            });

            filteredData.forEach((item) => {
