                } else if (item.fileNota && item.fileNota !== '-') {
                    btnNotaHtml = `<span class="text-slate-600 font-semibold">${item.fileNota}</span>`;
                }

                tbody.innerHTML += `
                    <tr class="border-b hover:bg-slate-50">
                        <td class="p-2.5 font-bold text-slate-800">${item.tgl}</td>
                        <td class="p-2.5 font-bold text-slate-600">${item.nota}</td>
