        function hitungInvoice() {
            let originalSubtotal = activeInvoiceItems.reduce((acc, item) => acc + (item.qty * item.harga), 0);
            let finalTotal = originalSubtotal;

            // Logika Diskon
            const useDiskon = document.getElementById('inv-chk-diskon').checked;
            const diskonPct = parseFloat(document.getElementById('inv-val-diskon').value) || 0;
            const rowDiskon = document.getElementById('row-diskon');
            const rowSubtotal = document.getElementById('row-subtotal');

            if (useDiskon) {
                const nominalDiskon = originalSubtotal * (diskonPct / 100);
                finalTotal = originalSubtotal - nominalDiskon;

                document.getElementById('out-subtotal').innerText = 'Rp ' + originalSubtotal.toLocaleString('id-ID');
                document.getElementById('out-diskon-persen').innerText = diskonPct;
                document.getElementById('out-diskon-nominal').innerText = '- Rp ' + nominalDiskon.toLocaleString('id-ID');
                
                rowSubtotal.classList.remove('hidden');
                rowDiskon.classList.remove('hidden');
            } else {
                rowSubtotal.classList.add('hidden');
                rowDiskon.classList.add('hidden');
            }

            // Logika DP
            const useDP = document.getElementById('inv-chk-dp').checked;
            const dpPct = parseFloat(document.getElementById('inv-val-dp').value) || 0;
            const targetDP = useDP ? finalTotal * (dpPct / 100) : 0;
            const rowDP = document.getElementById('row-dp');

            if (useDP) {
                document.getElementById('out-dp-persen').innerText = dpPct;
                document.getElementById('out-target-dp').innerText = 'Rp ' + targetDP.toLocaleString('id-ID');
                rowDP.classList.remove('hidden');
            } else {
                rowDP.classList.add('hidden');
            }

            // Hitung Terbayar & Sisa Piutang
            const totalTerbayar = activeInvoiceRiwayat.reduce((acc, item) => acc + item.nominal, 0);
            const sisaPiutang = finalTotal - totalTerbayar;

            document.getElementById('out-total-tagihan').innerText = 'Rp ' + finalTotal.toLocaleString('id-ID');
            document.getElementById('out-total-terbayar').innerText = 'Rp ' + totalTerbayar.toLocaleString('id-ID');
            document.getElementById('out-sisa-piutang').innerText = 'Rp ' + sisaPiutang.toLocaleString('id-ID');

            if (finalTotal === 0) {
                document.getElementById('out-terbilang').innerText = "Nol Rupiah";
            } else {
                const teksTerbilang = terbilang(finalTotal);
                document.getElementById('out-terbilang').innerText = teksTerbilang.charAt(0).toUpperCase() + teksTerbilang.slice(1) + " Rupiah";
            }

            const badge = document.getElementById('badge-status-inv');
            const statusVal = document.getElementById('inv-status-select').value;
            badge.innerText = statusVal.toUpperCase();
            
            if (statusVal.includes('Lunas')) {
                badge.className = "inline-block mt-1 px-3 py-0.5 text-[10px] font-black uppercase text-white bg-emerald-600 rounded";
            } else if (statusVal.includes('DP')) {
                badge.className = "inline-block mt-1 px-3 py-0.5 text-[10px] font-black uppercase text-white bg-amber-500 rounded";
            } else {
                badge.className = "inline-block mt-1 px-3 py-0.5 text-[10px] font-black uppercase text-white bg-rose-600 rounded";
            }
        }

