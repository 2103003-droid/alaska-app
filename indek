                            <span class="text-emerald-400 font-bold">Rp ${saldo.toLocaleString('id-ID')}</span>
                            <i onclick="hapusAkunKas(${index})" class="fa-solid fa-xmark text-slate-500 hover:text-rose-500 cursor-pointer text-xs ml-1"></i>
                        </div>
                    </div>`;

                selectKas.innerHTML += `<option value="${akun}">${akun}</option>`;
                selectCicil.innerHTML += `<option value="${akun}">${akun}</option>`;
                selectExport.innerHTML += `<option value="${akun}">${akun}</option>`;
