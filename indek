        function pilihAkunKas(namaAkun) {
            selectedAkunKas = namaAkun;
            renderAkunKas();
            renderTabelKas();

            const title = namaAkun === '' ? 'Semua Akun Kas' : namaAkun;
            document.getElementById('label-akun-aktif').innerText = title;
            document.getElementById('label-tabel-akun').innerText = title;

            if (namaAkun !== '') {
                document.getElementById('kas-akun').value = namaAkun;
            }
        }

        function renderAkunKas() {
            const cont = document.getElementById('container-akun-kas');
            const selectKas = document.getElementById('kas-akun');
            const selectCicil = document.getElementById('cicil-kas-tujuan');
            const selectExport = document.getElementById('export-kas-akun');
            
            cont.innerHTML = '';
            selectKas.innerHTML = '';
            selectCicil.innerHTML = '';
            selectExport.innerHTML = '<option value="">-- Semua Akun Kas --</option>';

            const isAllActive = selectedAkunKas === '';
            cont.innerHTML += `
                <div onclick="pilihAkunKas('')" class="flex justify-between items-center cursor-pointer p-1.5 rounded transition ${isAllActive ? 'bg-cyan-950 text-cyan-400 font-bold' : 'text-cyan-400 hover:bg-slate-900'}">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px]">•</span>
                        <span>Semua Akun Kas</span>
                    </div>
                </div>`;

            akunKas.forEach((akun, index) => {
                const masuk = dataKas.filter(k => k.akun === akun && k.jenis === 'masuk').reduce((a, b) => a + b.nominal, 0);
                const keluar = dataKas.filter(k => k.akun === akun && k.jenis === 'keluar').reduce((a, b) => a + b.nominal, 0);
                const saldo = masuk - keluar;

                const isActive = selectedAkunKas === akun;

                cont.innerHTML += `
                    <div class="flex justify-between items-center group p-1.5 rounded transition ${isActive ? 'bg-slate-800 text-white font-bold' : 'text-slate-300 hover:bg-slate-900'}">
                        <div onclick="pilihAkunKas('${akun}')" class="flex items-center gap-2 cursor-pointer flex-1">
                            <span class="text-[10px] ${isActive ? 'text-cyan-400' : 'text-slate-500'}">•</span>
